async function addTask() {

    const response = await fetch(
        "http://localhost:5000/tasks",
        {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                title: task
            })
        }
    );

    const newTask = await response.json();

    setTasks([...tasks, newTask]);

    setTask("");
}
